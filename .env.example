# Copy to .env (gitignored) and adjust. Read by the justfile.
# Extension directories of the remote installs, for `just deploy-webui` / `just deploy-comfy`.
# Use forward slashes; PowerShell converts them (the shell passes \ of a UNC path to it as \).
WEBUI_DEST=//server/share/sd/webui/extensions/image-bench
COMFY_DEST=//server/share/sd/comfyui/ComfyUI/custom_nodes/image-bench
# GIMP profile folder for `just gimp-deploy`, if not the newest %APPDATA%/GIMP/3.x (GIMP Portable: Data/GimpAppData)
# GIMP3_DIRECTORY=D:/software/graphics/gimp/Data/GimpAppData
