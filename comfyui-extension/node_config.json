  "hires_fix": {
    "_comment": "The switch of the Hires. fix pass, e.g. an If/Else Switch choosing between the images of the first and the second pass. All marked nodes are set together.",
    "marker": "hr",
    "nodeTypes": [
      "ComfySwitchNode",
      "ComfySoftSwitchNode",
      "PrimitiveBoolean"
    ],
    "widgetNames": {
      "ComfySwitchNode": "switch",
      "ComfySoftSwitchNode": "switch",
      "PrimitiveBoolean": "value"
    }
  },
  "generation_params": {
    "_comment": "Where the Generate tab parameters live, relative to the sampler marked ib:smp (role sampler) or ib:smp:1 (role hiresSampler). The first locator that resolves wins: a widget of the sampler itself, or of a node of `types` reached through the inputs in `via`, then further upstream with `deep` (true: through any input, a name: through that input only). Deep walks do not pass the sampler node types.",
    "seed": [
      {
        "widget": "seed"
      },
      {
        "widget": "noise_seed"
      },
      {
        "via": [
          "noise"
        ],
        "types": [
          "RandomNoise"
        ],
        "widget": "noise_seed"
      }
    ],
    "steps": [
      {
        "widget": "steps"
      },
      {
        "via": [
          "sigmas"
        ],
        "deep": true,
        "types": [
          "BasicScheduler",
          "Flux2Scheduler",
          "Ideogram4Scheduler"
        ],
        "widget": "steps"
      }
    ],
    "cfg": [
      {
        "widget": "cfg"
      },
      {
        "via": [
          "guider"
        ],
        "types": [
          "CFGGuider",
          "DualCFGGuider",
          "DualModelGuider"
        ],
        "widget": "cfg"
      }
    ],
    "sampler": [
      {
        "widget": "sampler_name"
      },
      {
        "via": [
          "sampler"
        ],
        "types": [
          "KSamplerSelect"
        ],
        "widget": "sampler_name"
      }
    ],
    "scheduler": [
      {
        "widget": "scheduler"
      },
      {
        "via": [
          "sigmas"
        ],
        "deep": true,
        "types": [
          "BasicScheduler"
        ],
        "widget": "scheduler"
      }
    ],
    "denoise": [
      {
        "widget": "denoise"
      },
      {
        "via": [
          "sigmas"
        ],
        "deep": true,
        "types": [
          "BasicScheduler"
        ],
        "widget": "denoise"
      },
      {
        "via": [
          "sigmas"
        ],
        "deep": true,
        "types": [
          "SplitSigmasDenoise"
        ],
        "widget": "denoise"
      }
    ],
    "guidance": [
      {
        "via": [
          "positive"
        ],
        "deep": "conditioning",
        "types": [
          "FluxGuidance"
        ],
        "widget": "guidance"
      },
      {
        "via": [
          "guider"
        ],
        "deep": true,
        "types": [
          "FluxGuidance"
        ],
        "widget": "guidance"
      }
    ],
    "shift": [
      {
        "via": [
          "model"
        ],
        "deep": "model",
        "types": [
          "ModelSamplingSD3",
          "ModelSamplingAuraFlow"
        ],
        "widget": "shift"
      },
      {
        "via": [
          "guider"
        ],
        "deep": true,
        "types": [
          "ModelSamplingSD3",
          "ModelSamplingAuraFlow"
        ],
        "widget": "shift"
      },
      {
        "via": [
          "sigmas"
        ],
        "deep": true,
        "types": [
          "Ideogram4Scheduler"
        ],
        "widget": "mu"
      }
    ],
    "width": [
      {
        "via": [
          "latent_image",
          "width"
        ],
        "types": [
          "PrimitiveInt",
          "PrimitiveNode"
        ],
        "widget": "value"
      },
      {
        "via": [
          "latent_image"
        ],
        "types": [
          "EmptyLatentImage",
          "EmptySD3LatentImage",
          "EmptyHunyuanLatentVideo",
          "EmptyHunyuanImageLatent",
          "EmptyFlux2LatentImage",
          "EmptyQwenImageLayeredLatentImage",
          "EmptyLTXVLatentVideo",
          "EmptyMochiLatentVideo",
          "EmptyCosmosLatentVideo"
        ],
        "widget": "width"
      },
      {
        "from": "inpaintCrop",
        "widget": "output_target_width"
      }
    ],
    "height": [
      {
        "via": [
          "latent_image",
          "height"
        ],
        "types": [
          "PrimitiveInt",
          "PrimitiveNode"
        ],
        "widget": "value"
      },
      {
        "via": [
          "latent_image"
        ],
        "types": [
          "EmptyLatentImage",
          "EmptySD3LatentImage",
          "EmptyHunyuanLatentVideo",
          "EmptyHunyuanImageLatent",
          "EmptyFlux2LatentImage",
          "EmptyQwenImageLayeredLatentImage",
          "EmptyLTXVLatentVideo",
          "EmptyMochiLatentVideo",
          "EmptyCosmosLatentVideo"
        ],
        "widget": "height"
      },
      {
        "from": "inpaintCrop",
        "widget": "output_target_height"
      }
    ],
    "_inpaint": "Inpaint Crop (ComfyUI-Inpaint-CropAndStitch) of the inpaint workflows: inpaintCrop is an anchor without a widget, the start (from) of the inpaint parameters. values maps the choice labels of the Generate tab to widget values.",
    "inpaintCrop": [
      {
        "via": [
          "latent_image"
        ],
        "deep": true,
        "types": [
          "InpaintCropImproved"
        ]
      }
    ],
    "maskBlur": [
      {
        "from": "inpaintCrop",
        "widget": "mask_blend_pixels"
      }
    ],
    "maskMode": [
      {
        "from": "inpaintCrop",
        "widget": "mask_invert",
        "values": {
          "Inpaint masked": false,
          "Inpaint not masked": true
        }
      }
    ],
    "inpaintArea": [
      {
        "from": "inpaintCrop",
        "via": [
          "optional_context_mask"
        ],
        "deep": true,
        "types": [
          "SolidMask"
        ],
        "widget": "value",
        "values": {
          "Whole picture": 1,
          "Only masked": 0
        }
      }
    ],
    "inpaintPadding": [
      {
        "from": "inpaintCrop",
        "via": [
          "optional_context_mask"
        ],
        "deep": true,
        "types": [
          "GrowMask"
        ],
        "widget": "expand"
      }
    ],
    "hiresSteps": [
      {
        "role": "hiresSampler",
        "widget": "steps"
      },
      {
        "role": "hiresSampler",
        "via": [
          "sigmas"
        ],
        "deep": true,
        "types": [
          "BasicScheduler",
          "Flux2Scheduler",
          "Ideogram4Scheduler"
        ],
        "widget": "steps"
      }
    ],
    "hiresDenoise": [
      {
        "role": "hiresSampler",
        "widget": "denoise"
      },
      {
        "role": "hiresSampler",
        "via": [
          "sigmas"
        ],
        "deep": true,
        "types": [
          "BasicScheduler"
        ],
        "widget": "denoise"
      },
      {
        "role": "hiresSampler",
        "via": [
          "sigmas"
        ],
        "deep": true,
        "types": [
          "SplitSigmasDenoise"
        ],
        "widget": "denoise"
      }
    ],
    "hiresScale": [
      {
        "role": "hiresSampler",
        "via": [
          "latent_image"
        ],
        "deep": true,
        "types": [
          "LatentUpscaleBy",
          "ImageScaleBy"
        ],
        "widget": "scale_by"
      }
    ],
    "hiresUpscaler": [
      {
        "role": "hiresSampler",
        "via": [
          "latent_image"
        ],
        "deep": true,
        "types": [
          "UpscaleModelLoader"
        ],
        "widget": "model_name"
      },
      {
        "role": "hiresSampler",
        "via": [
          "latent_image"
        ],
        "deep": true,
        "types": [
          "LatentUpscaleBy",
          "ImageScaleBy"
        ],
        "widget": "upscale_method"
      }
    ]
  }
}
